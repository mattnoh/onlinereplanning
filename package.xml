<?xml version="1.0"?>
<package format="3">
 <name>comando_planner</name><version>0.2.0</version>
 <description>ROS-independent CoManDO RH and direct MPC core with ROS1 and ROS2 transports</description>
 <maintainer email="lab@example.com">CoManDO maintainers</maintainer><license>MIT</license>
 <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
 <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>
 <depend condition="$ROS_VERSION == 1">roscpp</depend>
 <depend condition="$ROS_VERSION == 1">mavros_msgs</depend>
 <depend condition="$ROS_VERSION == 2">rclcpp</depend>
 <depend condition="$ROS_VERSION == 2">crazyflie_interfaces</depend>
 <depend condition="$ROS_VERSION == 2">visualization_msgs</depend>
 <depend>nav_msgs</depend><depend>geometry_msgs</depend><depend>trajectory_msgs</depend><depend>tf2_ros</depend><depend>eigen</depend>
 <export><build_type condition="$ROS_VERSION == 1">catkin</build_type><build_type condition="$ROS_VERSION == 2">ament_cmake</build_type></export>
</package>
