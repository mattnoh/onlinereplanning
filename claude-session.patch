+            Eigen::Vector4d q = (1.0 - a_vel) * q_pred + a_vel * q_live;
+            const double qn = q.norm();
+            out.segment(6, 4) = (qn > 1e-9) ? Eigen::Vector4d(q / qn) : q_pred;
+        }
+        if (n >= 13) out.segment(10, 3) += a_vel * err.segment(10, 3);
+        return out;
