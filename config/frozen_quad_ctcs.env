# Frozen-time measured-root CTCS profile, validated on the staging-hover
# moving-target case in test_measured_root_rh (K=4, matched perfect plant).
# Same interval-only STC interface, fresh numerical state, no nodal STC guards.
# Other cold starts / stationary-target cases are not covered by this pass;
# known failing checks and discarded trials are retained in the evidence JSON.
export SZMUK_N=80
export SZMUK_MAX_ITER=1200
export SZMUK_W_EPS=0.0
export SZMUK_W_TOUCH_VEL=0.0
export SZMUK_R_THETA=0.0
export SZMUK_W_POS_XY=0.0
export SZMUK_W_POS_Z=0.0
export SZMUK_W_VEL=0.0
export SZMUK_RHO=100.0
export SZMUK_RHO_MUL=10.0
export SZMUK_REG2_MIN=0.1
export SZMUK_CTCS_MODE=step_ineq
# Equivalent positive row scaling; budget remains 1e-5. Validated native
# overspend is 8.83e-12 in physical integral units, not a strict-zero claim.
export SZMUK_CTCS_Y_SCALE=0.5
export SZMUK_CTCS_STEP_EPS=1e-05
export SZMUK_LOS_TRIGGER_FLOOR=0.0
export SZMUK_W_LAND_SPEED=100
export SZMUK_W_LAND_TILT=300000000
export SZMUK_W_LAND_OMEGA=1000000
export SZMUK_W_LAND_GS=7500
export SZMUK_W_STC_STAGE=100
export SZMUK_W_STC_LOS=200
export SZMUK_BOUND_SCALE=1
export SZMUK_MU=0.1
export SZMUK_RH_N=80
export SZMUK_CTCS_TRIGGER_MARGIN=.05
export SZMUK_CTCS_GEOMETRIC_MARGIN=0.02
export SZMUK_CTCS_SPEED_MARGIN=.05
export SZMUK_CTCS_TILT_MARGIN_DEG=.2
export SZMUK_CTCS_PATH_TILT_MARGIN_DEG=.5
export SZMUK_CTCS_RATE_MARGIN=.005
export SZMUK_RHOT=100
export SZMUK_TERM_W_POS_XY=100000
export SZMUK_TERM_W_POS_Z=10000
export SZMUK_SOLVER_VERBOSE=0
export SZMUK_TH0=.07
export SZMUK_THL=.05
export SZMUK_THH=.12
export SZMUK_MUT=.1
export SZMUK_MU_MUL=.1
export SZMUK_FORWARD_FILTER=1
export SZMUK_TOL=1e-6
export SZMUK_QUAD_TRIG_STC=1
export SZMUK_STAGE_TRIGGER=radius
export SZMUK_STAGE_TRIGGER_FLOOR=0
export SZMUK_RH_CAPTURE_LANDING_TRIGGER=0
