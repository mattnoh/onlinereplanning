# Source config/frozen_quad_ctcs_coarse.env, then
# config/ros1/tuning_stc_measured_rh_sitl_widened.env, then this file.
# Moving-target PX4/Gazebo measured-state RH (all six campaign motions landed,
# no stale plan; residual excess listed in measured_sitl_moving_20261118 in
# support/test/frozen_node_baseline.json).
# Profile: config/ros1/profile_stc_landing_noaug_measured_sitl_moving.yaml.
# Launch with SZMUK_Z_STAGE=1.8 and SZMUK_LOS_ALT_TRIG=1.5 (the campaign
# passes stc_los_alt_trig on the planner launch line).
#
# Widened physical bounds, sized from moving-target flight data:
#   landing tilt 0.95 -> 3.5 deg  (stop_and_go 0.4 m/s^2 ramp needs 2.3 deg + PX4 jitter)
#   landing rate 0.022 -> 0.06    (PX4 body-rate noise in calm descents 0.02-0.057)
#   approach rate 0.35 -> 0.65    (PX4 overshoot 0.54-0.58 at target reversals)
#   glideslope 17 -> 26 deg, apex 0.10 -> 0.25 m (lateral offsets 0.2-0.35 m near the trigger)
#   LOS cone 34 -> 40 deg, LOS trigger 1.8 -> 1.5 m (room to correct laterally / maneuver
#     outside the cone between the staging floor and the LOS trigger)
export SZMUK_TILT_STC_DEG=3.5
export SZMUK_OMEGA_STC_MAX=0.06
export SZMUK_OMEGA_PHASE0_MAX=0.65
export SZMUK_GS_CONE_DEG=26
export SZMUK_GS_APEX_OFFSET=0.25
export SZMUK_LOS_CONE_DEG=40
export SZMUK_LOS_ALT_TRIG=1.5
# Minimum interval 0.06 s so a plan near the ground can be shorter than 4 s.
export SZMUK_THL=0.06
# Intervals before node 4 from the measured root use physical (untightened) rows.
export SZMUK_CTCS_TIGHTEN_FROM_NODE=4
# Initial barrier parameter.
export SZMUK_MU=1
# Staged native guess: approach above the LOS trigger, descend inside the glideslope.
export SZMUK_NATIVE_GUESS=staged
