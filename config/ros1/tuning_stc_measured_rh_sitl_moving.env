# Source config/frozen_quad_ctcs_coarse.env, then
# config/ros1/tuning_stc_measured_rh_sitl_widened.env, then this file.
# Moving-target PX4/Gazebo measured-state RH. See measured_sitl_moving_20261118
# in support/test/frozen_node_baseline.json for the flight record.
# Profile: config/ros1/profile_stc_landing_noaug_measured_sitl_moving.yaml.
# Launch with SZMUK_Z_STAGE=1.8 and SZMUK_LOS_ALT_TRIG=1.5 (the campaign
# passes stc_z_stage / stc_los_alt_trig on the planner launch line).
#
# Physical bounds. Sized from the PLANNED trajectories (dense 1 ms audit of
# every accepted horizon, 52 moving-target flights), not from PX4 tracking
# error. Original values in parentheses.
#   approach tilt 8 deg (11)        plans used <= 7.2 deg above the LOS trigger
#   approach rate 0.2 rad/s (0.35)  plans used <= 0.13
#   approach speed 2.0 m/s (3.0)    plans used <= 1.9
#   landing rate 0.15 rad/s (0.019) plans used <= 0.148 (90% of flights <= 0.083)
#   landing tilt 5 deg (0.95), landing speed 1.0 m/s (0.75), glideslope 31 deg
#   with apex 0.25 m (15 deg, 0.10 m), LOS cone 57 deg (30) with trigger 1.5 m
#   (1.8): plans press against these (active), so their use does not show the
#   need; they stay at the values the moving-target flights required.
export SZMUK_TILT_STC_DEG=5
export SZMUK_OMEGA_STC_MAX=0.15
export SZMUK_TILT_PHASE0_DEG=8
export SZMUK_OMEGA_PHASE0_MAX=0.2
export SZMUK_SPD_PHASE0_MAX=2.0
export SZMUK_SPD_STC_MAX=1.0
export SZMUK_GS_CONE_DEG=31
export SZMUK_GS_APEX_OFFSET=0.25
export SZMUK_LOS_CONE_DEG=57
export SZMUK_LOS_ALT_TRIG=1.5
# Optimizer buffers inside those bounds.
export SZMUK_CTCS_TRIGGER_MARGIN=0.2
export SZMUK_CTCS_GEOMETRIC_MARGIN=0.05
export SZMUK_CTCS_STAGE_HEIGHT_MARGIN=0.12
export SZMUK_CTCS_STAGE_RADIUS_MARGIN=0.7
export SZMUK_CTCS_RATE_MARGIN=0.06
export SZMUK_CTCS_SPEED_MARGIN=0.2
export SZMUK_CTCS_LOS_MARGIN=0.09
# Intervals before node 4 from the measured root use physical (untightened)
# rows, with trigger floors so the physical boundary is enforced sharply.
export SZMUK_CTCS_TIGHTEN_FROM_NODE=4
# Minimum interval 0.06 s so a plan near the ground can be shorter than 4 s.
export SZMUK_THL=0.06
# Initial barrier parameter.
export SZMUK_MU=1
# Staged native guess: approach above the LOS trigger, descend inside the glideslope.
export SZMUK_NATIVE_GUESS=staged
export SZMUK_GUESS_HOLD_DZ=0.25
