# Source config/frozen_quad_ctcs_coarse.env first, then this file.
# Stationary-target PX4/Gazebo measured-state RH: 8/8 landed, zero physical
# excess against these (widened) bounds; see measured_sitl_widened_20261117 in
# support/test/frozen_node_baseline.json. Moving targets not validated.
# Profile: config/ros1/profile_stc_landing_noaug_measured_sitl_widened.yaml.
# Keep SZMUK_Z_STAGE=1.8 / SZMUK_LOS_ALT_TRIG=1.8 at launch.
export SZMUK_N=40
export SZMUK_RH_N=40
export SZMUK_TH0=0.13999999999999999
export SZMUK_THL=0.1
export SZMUK_THH=0.24
# Widened physical bounds (original: GS 15 deg, LOS 30 deg, rate 0.019, stage radius 1.10)
export SZMUK_GS_CONE_DEG=17
export SZMUK_LOS_CONE_DEG=34
export SZMUK_OMEGA_STC_MAX=0.022
export SZMUK_STAGE_RADIUS=1.2
# Tightening margins
export SZMUK_CTCS_SPEED_MARGIN=.08
export SZMUK_CTCS_LOS_MARGIN=.045
export SZMUK_CTCS_GS_ANGLE_MARGIN_DEG=3
export SZMUK_CTCS_STAGE_RADIUS_MARGIN=.3
# First interval from the measured root uses the physical bounds only.
export SZMUK_CTCS_TIGHTEN_FROM_NODE=1
# Hover/rate-damped native initial guess (stops above the floor).
export SZMUK_NATIVE_GUESS=stabilized
