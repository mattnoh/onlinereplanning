# Source before starting the ROS1 planner for stc_landing_mpc MC1/MC2 campaigns.
# OCP numbers: preset "mc" in include/ocp/ocp_stc_landing_mpc.hpp (staging 1.5 m
# and LOS trigger 1.2 m are part of it). Circle verified; other motions require
# their saved-run validation report. Audit against MC1's original 0.8 m
# activation, 0.019 rad/s, 15/30 degree cones and 1.3 m staging.
export STC_MPC_PRESET=mc
# PX4 platform: rate loop and motor thrust mapping.
export MPC_NATIVE_PX4=0 MPC_RATE_TAU=.08 MPC_RATE_LIMIT=.18 MPC_MAX_POLICY_AGE=1
export MPC_HOVER_THRUST=.7282821834 MPC_MOTOR_THRUST_EXPONENT=2
export MPC_MOTOR_SPEED_OFFSET=.17647058823529413
