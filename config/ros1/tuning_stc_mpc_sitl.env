# Source before starting ROS1 planner: parameters are read at process startup.
# Optimizer margins, not replacement physical limits. Audit against MC1's
# original 0.8 m activation, 0.019 rad/s, 15/30 degree cones and 1.3 m staging.
# Launch with stc_z_stage:=1.5 stc_los_alt_trig:=1.2 (launch overrides these).
export MPC_MAX_ITER=120 MPC_WARM_ITER=24 MPC_ANGULAR_RATE_WEIGHT=1000
export MPC_SLEW_THR=.1 MPC_SLEW_RATE=2 MPC_NATIVE_PX4=0
export MPC_RATE_TAU=.08 MPC_RATE_LIMIT=.35 MPC_MAX_POLICY_AGE=1
export MPC_HOVER_THRUST=.7282821834 MPC_MOTOR_THRUST_EXPONENT=2
export MPC_MOTOR_SPEED_OFFSET=.17647058823529413
export SZMUK_RH_N=40 SZMUK_MAX_ITER=120 SZMUK_THH=.16
export SZMUK_CTCS_STEP_EPS=.00001
export SZMUK_LOS_TRIGGER_FLOOR=1 SZMUK_STAGE_TRIGGER_FLOOR=1
export SZMUK_W_STC_STAGE=100 SZMUK_W_STC_LOS=1000 SZMUK_W_LAND_GS=20000
export SZMUK_W_LAND_OMEGA=100 SZMUK_W_LAND_TILT=100000 SZMUK_W_LAND_SPEED=1
export SZMUK_QUAD_TRIG_STC=1 SZMUK_RH_CAPTURE_LANDING_TRIGGER=0 SZMUK_STAGE_TRIGGER=radius
export SZMUK_ALT_TRIG=1.0 SZMUK_OMEGA_STC_MAX=.012
export SZMUK_GS_CONE_DEG=12 SZMUK_LOS_CONE_DEG=25
export SZMUK_Z_STAGE=1.5 SZMUK_LOS_ALT_TRIG=1.2
